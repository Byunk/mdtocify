{
  "name": "mdtocify",
  "version": "0.1.4",
  "description": "A simple and efficient TypeScript library for generating table of contents (TOC) from Markdown text. Extract headings and create structured navigation for your documentation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && npm run build",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.ts",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.ts --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.ts --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage node_modules/.cache",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "release": "npm run clean && npm run build && npm test && npm publish"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byunk/mdtocify.git"
  },
  "keywords": [
    "markdown",
    "table-of-contents",
    "toc",
    "md",
    "mdtocify",
    "typescript",
    "parser",
    "navigation",
    "headings",
    "documentation",
    "static-site-generator",
    "blog",
    "cms",
    "remark",
    "unified"
  ],
  "homepage": "https://github.com/Byunk/mdtocify#readme",
  "bugs": {
    "url": "https://github.com/Byunk/mdtocify/issues",
    "email": "kyungho.byoun@gmail.com"
  },
  "author": "Kyungho Byoun <kyungho.byoun@gmail.com> (https://github.com/Byunk)",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Byunk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "dependencies": {
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@eslint/js": "^9.31.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.5.5",
    "babel-jest": "^29.7.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.37.0"
  }
}
